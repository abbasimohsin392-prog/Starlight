{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "starlight",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    {
      "name": "AI_SESSION_RATE_LIMITER",
      "namespace_id": "9273618241",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "AI_TEXT_RATE_LIMITER",
      "namespace_id": "9273618242",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/pricing*",
      "/services*",
      "/solutions*",
      "/contact*",
      "/privacy*",
      "/terms*",
      "/demo/*",
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
      "/opengraph-image*",
      "/twitter-image*"
    ]
  }
}
