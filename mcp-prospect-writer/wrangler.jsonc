{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starlight-prospect-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "f8694a64c6e1474c8df5967e1bdab153"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONSENT_FORM_STORE",
        "class_name": "OAuthConsentFormStore"
      }
    ]
  },
  "exports": {
    "OAuthConsentFormStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
