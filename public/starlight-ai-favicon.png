    <!-- Consent Mode v2 defaults — must run before GTM. The stored decision
         is applied synchronously here: consent-gated container tags are
         evaluated at the page-view event, which happens before the app
         hydrates, so a default set from storage is the only signal that
         reaches them in time. Absent/malformed/stale state stays denied.
         Parsing rules (version, 13-month expiry) are kept in sync by hand
         with readConsent() in src/lib/cookie-consent.ts. -->
    <script>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      ;(function () {
        var marketing = false
        var analytics = false
        try {
          var parsed = JSON.parse(localStorage.getItem('sb_cookie_consent_v1') || 'null')
          if (parsed && typeof parsed.decidedAt === 'string' && parsed.version === 2) {
            var expiry = new Date(parsed.decidedAt)
            expiry.setMonth(expiry.getMonth() + 13)
            if (expiry.getTime() > Date.now()) {
              marketing = parsed.marketing === true
              analytics = parsed.analytics === true
            }
          }
        } catch (e) {
          /* stay denied */
        }
        gtag('consent', 'default', {
          ad_storage: marketing ? 'granted' : 'denied',
          analytics_storage: analytics ? 'granted' : 'denied',
          ad_user_data: marketing ? 'granted' : 'denied',
          ad_personalization: marketing ? 'granted' : 'denied',
          wait_for_update: 500
        })
      })()
    </script>
    <!-- Google Tag Manager -->
